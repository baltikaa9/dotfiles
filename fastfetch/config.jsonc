{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#63c6ff",
      "2": "#63c6dc",
      "3": "#bfc6dc"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#e2e2e9",
      "keys": "#afc6ff",
      "title": "#bfc6dc"
    },
    "percent": {
      "color": {
        "green": "#dfbbde",
        "yellow": "#afc6ff",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#aec6ff"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#aec6ff"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#dfbbde"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#bfc6dc"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#455e91"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
